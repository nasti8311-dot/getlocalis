{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getlocalis",
  "main": "./marketplace-entry.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiiviu-payouts",
      "database_id": "c445e0ff-8013-4e20-988b-71b019c41db7"
    }
  ]
}
