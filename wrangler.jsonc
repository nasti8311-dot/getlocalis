{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getlocalis",
  "main": "./worker.js",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
