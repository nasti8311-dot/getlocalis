{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "getlocalis",
  "main": "./secure-entry.js",
  "compatibility_date": "2026-09-14",
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".github/**",
      ".wrangler/**",
      "node_modules/**",
      "*.sql",
      "*.jsonc",
      "*.yaml",
      "*.yml",
      "*.md",
      "secure-entry.js",
      "marketplace-entry.js",
      "worker-entry.js",
      "worker-entry-v2.js",
      "worker.js",
      "stripe-webhook.js",
      "provider-auth.js"
    ],
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fiiviu-payouts",
      "database_id": "c445e0ff-8013-4e20-988b-71b019c41db7"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": [
        "noreply@fiiviu.ro"
      ]
    }
  ]
}
